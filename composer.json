{
    "name": "artefactual/accesstomemory",
    "type": "project",
    "description": "A web-based, open source application for standards-based archival description.",
    "keywords": [
        "archives",
        "archival-description"
    ],
    "license": "AGPL-3.0-only",
    "config": {
        "vendor-dir": "vendor/composer"
    },
    "require-dev": {
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phing/phing": "^3.1"
    },
    "require": {
        "php": "^8.3",
        "erusev/parsedown": "~1.7.4",
        "erusev/parsedown-extra": "~0.8.1",
        "league/csv": "^9.4",
        "apereo/phpcas": "^1.6.1",
        "ezyang/htmlpurifier": "^4.13",
        "ruflin/elastica": "7.*",
        "jumbojett/openid-connect-php": "^1.0",
        "geoip2/geoip2": "~2.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/console": "^7.4",
        "symfony/css-selector": "^7.4",
        "symfony/routing": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/translation": "^7.4",
        "symfony/intl": "^7.4",
        "symfony/form": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/security-csrf": "^7.4"
    },
    "autoload": {
        "classmap": [
            "vendor/FreeBeerIso639Map.php"
        ],
        "exclude-from-classmap": [
            "src/Framework/Bridge/ZendAclRoleInterface.php",
            "src/Framework/Form/Validators.php",
            "src/Framework/Form/Widgets.php"
        ],
        "psr-4": {
            "Atom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AccessToMemory\\test\\": "test/"
        }
    },
    "scripts": {
        "test": [
            "@test-application",
            "@test-framework"
        ],
        "test-application": "phpunit",
        "test-framework": "phpunit -c phpunit.framework.xml",
        "test-debug": [
            "@putenv XDEBUG_SESSION=1",
            "@test"
        ],
        "test-cov": [
            "@test-application-cov",
            "@test-framework-cov"
        ],
        "test-application-cov": "@php -dpcov.enabled=1 -dpcov.directory=. ./vendor/composer/bin/phpunit --coverage-html=.coverage/application",
        "test-framework-cov": "@php -dpcov.enabled=1 -dpcov.directory=src ./vendor/composer/bin/phpunit -c phpunit.framework.xml --coverage-html=.coverage/framework",
        "test-cov-strict": [
            "@test-application-cov-strict",
            "@test-framework-cov-strict"
        ],
        "test-application-cov-strict": "@php -dpcov.enabled=1 -dpcov.directory=. ./vendor/composer/bin/phpunit --coverage-html=.coverage/application --strict-coverage",
        "test-framework-cov-strict": "@php -dpcov.enabled=1 -dpcov.directory=src ./vendor/composer/bin/phpunit -c phpunit.framework.xml --coverage-html=.coverage/framework --strict-coverage",
        "test-framework-cov-ci": [
            "@php -dpcov.enabled=1 -dpcov.directory=src ./vendor/composer/bin/phpunit -c phpunit.framework.xml --coverage-clover=.coverage/framework.xml",
            "@php test/coverage/check.php .coverage/framework.xml 50"
        ],
        "php-cs-fixer": "php-cs-fixer"
    }
}
