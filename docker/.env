# releases: https://github.com/keycloak/keycloak/releases
KC_VERSION=latest
# The link that will be used to redirect to Keycloak
KC_HOSTNAME=http://localhost
KC_PORT=8080
KC_REALM_NAME=artefactual
KC_LOG_LEVEL=INFO
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD= admin
ATOM_SERVER_HTTP_PORT=63001
ATOM_HOSTNAME=http://localhost
ATOM_USERNAME=demo
ATOM_DOMAIN=@example.com
ATOM_PASSWORD=demo
KC_ATOM_CLIENT_URL=http://127.0.0.1:63001
KC_CERT=./certs/cert.pem
KC_KEY=./certs/key.pem
KC_AM_CLIENT_URL=http://127.0.0.1:62080
